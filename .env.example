# Stratagem configuration. Copy to .env and fill in.
# .env is gitignored and never committed.
#
#   cp .env.example .env
#
# Values already exported in your shell take precedence over this file, so
#   LLM_BACKEND=replay ./run.sh ...
# works without editing anything here.

# ---------------------------------------------------------------------------
# Which backend drives the agentic loop
#   replay  no credentials, replays the recorded transcript in runs/. Default.
#   openai  any OpenAI-compatible /v1/chat/completions endpoint (see below)
#   cli     Claude Code headless, billed to a Claude subscription
# ---------------------------------------------------------------------------
LLM_BACKEND=replay

# Optional model override. Leave blank to use the backend's default.
LLM_MODEL=

# ---------------------------------------------------------------------------
# OpenAI-compatible backend (LLM_BACKEND=openai)
#
# One code path, several providers. Set the base URL to whichever you use:
#
#   OpenAI      https://api.openai.com/v1              LLM_MODEL=gpt-5
#   Anthropic   https://api.anthropic.com/v1           LLM_MODEL=claude-sonnet-5
#               (Anthropic serves an OpenAI-compatible layer on /v1)
#   local       http://localhost:11434/v1              (Ollama, vLLM, etc.)
#   gateway     whatever your proxy exposes
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Claude Code subscription backend (LLM_BACKEND=cli)
# Generate with:  claude setup-token
# Not needed when running claude interactively on the same machine.
# ---------------------------------------------------------------------------
CLAUDE_CODE_OAUTH_TOKEN=
